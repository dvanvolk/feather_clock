#pragma once

// Unique name for this device — used in MQTT topic paths and HA entity IDs.
// Use lowercase letters, numbers, and underscores only.
// Examples: "kitchen_clock", "bedroom_clock"
#define SECRET_DEVICE_NAME   "your_device_name"

// WiFi credentials
#define SECRET_WIFI_SSID     "your_wifi_ssid"
#define SECRET_WIFI_PASSWORD "your_wifi_password"

// MQTT broker credentials
// If your broker has no authentication, set USER and PASSWORD to ""
#define SECRET_MQTT_HOST     "192.168.1.x"
#define SECRET_MQTT_USER     "your_mqtt_username"
#define SECRET_MQTT_PASSWORD "your_mqtt_password"
